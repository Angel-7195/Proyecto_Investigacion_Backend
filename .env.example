MARIADB_ROOT_PASSWORD=cambiar_esta_clave
MARIADB_DATABASE=investigacion_php_local
MARIADB_USER=investigacion
MARIADB_PASSWORD=cambiar_esta_clave
JWT_SECRET=<generar una clave aleatoria de 32 bytes en hexadecimal>

# Cuenta ADMIN inicial de V3. Se crea solo si no existe un administrador activo.
# Configura estos valores en tu archivo .env privado (nunca en Git).
# No reutilices una contraseña de producción ni publiques la contraseña de ADMIN.
ADMIN_INICIAL_USERNAME=ADMIN
ADMIN_INICIAL_EMAIL=admin@investigacion.local
ADMIN_INICIAL_PASSWORD=CONTRASEÑA_ADMIN_INICIAL
LOGIN_DEMO_ENABLED=NUMERO_DEMO
LOGIN_DEMO_ADMIN_USERNAME=ADMIN_USUARIO
LOGIN_DEMO_ADMIN_PASSWORD=ADMIN_CONTRASEÑA

FRONT_PATH=../Proyecto_Investigacion_Frontend/front_php
